# Cloudflare Pages Build Dockerfile
# Optimized for Cloudflare Pages deployment using next-on-pages
# This builds the Next.js app and converts it to Cloudflare Pages format
# 
# Build context: Project root
# Usage: docker build -f landing/Dockerfile.pages -t dealscale-pages .
#
# This Dockerfile expects:
# - Root level: package.json, pnpm-lock.yaml, pnpm-workspace.yaml (optional)
# - landing/package.json, landing/pnpm-lock.yaml
# - packages/ directory (if monorepo)

FROM node:20-alpine AS base

# Install dependencies
FROM base AS deps
RUN apk add --no-cache libc6-compat git
WORKDIR /app

# Install pnpm first
RUN corepack enable && corepack prepare pnpm@latest --activate

# Copy landing package files (required)
COPY landing/package.json ./landing/
COPY landing/pnpm-lock.yaml* ./landing/
COPY landing/pnpm-workspace.yaml* ./landing/

# Copy root package files if they exist (for monorepo)
# Note: These may not exist - Docker will fail if they don't
# Use Dockerfile.pages.standalone if root files don't exist
COPY package.json* ./
COPY pnpm-lock.yaml* ./
COPY pnpm-workspace.yaml* ./

# Copy packages directory (for monorepo)
COPY packages ./packages/

# Install dependencies
# If root package.json exists, install from root (monorepo)
# Otherwise, install from landing directory
RUN if [ -f "package.json" ] && [ -f "pnpm-workspace.yaml" ]; then \
        echo "Installing monorepo dependencies..." && \
        pnpm install --frozen-lockfile; \
    else \
        echo "Installing landing dependencies..." && \
        cd landing && pnpm install --frozen-lockfile; \
    fi

# Build stage
FROM base AS builder
WORKDIR /app

# Install pnpm
RUN corepack enable && corepack prepare pnpm@latest --activate

# Copy dependencies from deps stage
COPY --from=deps /app/node_modules ./node_modules/
COPY --from=deps /app/landing/node_modules ./landing/node_modules/

# Copy all source code
COPY . .

# Build for Cloudflare Pages
WORKDIR /app/landing

ENV NEXT_TELEMETRY_DISABLED=1
ENV SKIP_HUSKY=1
ENV NODE_ENV=production
ENV CF_PAGES=1

# Build Next.js app
RUN pnpm run build

# Convert to Cloudflare Pages format
# This generates .vercel/output/static for Cloudflare Pages
RUN pnpm run build:cf

# Output stage - minimal image with just the build output
FROM scratch AS output

# Copy the Cloudflare Pages build output
COPY --from=builder /app/landing/.vercel/output/static /output

# The output directory contains:
# - Static HTML/CSS/JS files
# - _worker.js for Cloudflare Pages Functions
# - All assets optimized for Cloudflare's edge network



